@page "/"
@inject IDbContextFactory<AppDbContext> DbContextFactory
@using ESHOPMAT.Models
@using Microsoft.AspNetCore.Components

@if (RootPageContent == null)
{
    <p>Loading...</p> <!-- Simple loading indicator -->
}
else
{
    <DynamicComponentRendering Page="RootPageContent" IsEditing="false"></DynamicComponentRendering>
}

@code {
    private PageContent? RootPageContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var pageContext = await DbContextFactory.CreateDbContextAsync();
        RootPageContent = await GenerateMainPageTemplate(pageContext);
    }

    private async Task<PageContent> GenerateMainPageTemplate(AppDbContext context)
    {
        const string templateName = "MainPageTemplate"; // Fixed name for main page template
        PageContentDictionaryCache.Initialize(context);

        var allPages = context.Pages.ToList();
        var existingTemplate = allPages.FirstOrDefault(p => p.Name == templateName);

        if (existingTemplate != null)
        {
            return existingTemplate;
        }

        var newTemplate = CreateDefaultMainPageTemplate(context);
        await context.Pages.AddAsync(newTemplate);
        await context.SaveChangesAsync();

        return newTemplate;
    }

    private PageContent CreateDefaultMainPageTemplate(AppDbContext context)
    {
        // Root container for the page
        var rootSettings = new PageSettings
            {
                Name = "MainPageTemplate",
                Type = ComponentType.Container,
                IsRoot = true,
                Data = new Dictionary<string, object>
                {
                    ["columns"] = 16,
                    ["rows"] = 16,
                    ["rowHeight"] = 16
                }
            };

        var page = new PageContent(rootSettings, context);

        // Add TextBlock component
        var textBlock = new PageSettings
            {
                Name = "Text",
                Type = ComponentType.TextBlock,
                Row = 1,
                Col = 1,
                RowSpan = 2,
                ColSpan = 16,
                Data = new Dictionary<string, object>
                {
                    ["title"] = "Welcome",
                    ["text"] = "To Eshop"
                }
            };

        page.AddChild(textBlock);

        // Add ProductList component
        var productList = new PageSettings
            {
                Name = "FeaturedProducts",
                Type = ComponentType.ProductList,
                Row = 7,
                Col = 1,
                RowSpan = 6,
                ColSpan = 16,
                Data = new Dictionary<string, object>
                {
                    // Optional: initialize with empty list or IDs
                    ["ProductList"] = new List<Guid>()
                }
            };

        page.AddChild(productList);

        return page;
    }

}
